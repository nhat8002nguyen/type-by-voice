                ]
              }
            }
          ]
        },
        {
          "name": "Delete all transcripts",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/v1/transcripts",
            "description": "204. Soft-deletes every transcript owned by the caller; they disappear from list/search/export."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Dictation",
      "description": "WebSocket `{{wsUrl}}`. Upgrade uses `Authorization: Bearer {{accessToken}}`.\n\nClose codes: 4401 unauthenticated, 4403 quota exhausted, 4429 rate limited.\n\nAfter connect, send the **start** JSON text frame, wait for `ready`, then binary Ogg Opus. Postman is a poor fit for streaming audio — use `contracts/dictation-v1` (`DICTATE_TOKEN=<accessToken> npm run harness`) for a live session.\n\n`start.language` is the input language (`en` | `vi`); omit it to auto-detect. `start.translateToEnglish: true` returns English text (`vi → en`) in a single Groq call. `platform`, `clientVersion`, and `deviceId` on `start` must match the auth session. The upgrade is limited to 60/min/IP.",
      "item": [
        {
          "name": "Dictate session",
          "protocol": "websocket",
          "url": "{{wsUrl}}",
          "header": [
            {
              "key": "Authorization",
              "value": "Bearer {{accessToken}}",
              "type": "text"
            }
          ],
          "messages": [
            {
              "name": "start",
              "type": "text",
              "language": "json",
              "payload": "{\n  \"type\": \"start\",\n  \"requestId\": \"{{requestId}}\",\n  \"codec\": \"opus\",\n  \"container\": \"ogg\",\n  \"sampleRate\": 16000,\n  \"channels\": 1,\n  \"language\": \"vi\",\n  \"translateToEnglish\": false,\n  \"platform\": \"{{platform}}\",\n  \"clientVersion\": \"{{clientVersion}}\",\n  \"deviceId\": \"{{deviceId}}\"\n}"
            },
            {
              "name": "stop",
              "type": "text",
              "language": "json",
              "payload": "{\n  \"type\": \"stop\",\n  \"requestId\": \"{{requestId}}\",\n  \"durationMs\": 11800\n}"
            },
            {
              "name": "cancel",
              "type": "text",
              "language": "json",
              "payload": "{\n  \"type\": \"cancel\",\n  \"requestId\": \"{{requestId}}\"\n}"
            }
          ]
        }
      ]
    }
  ]
}
