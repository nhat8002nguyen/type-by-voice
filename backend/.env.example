# Copy to backend/.env. Compose loads this file automatically.
# Recreate containers after changing values: docker compose up -d

# Leave empty to keep the fake transcriber. Set a key to use Groq.
GROQ_API_KEY=

# whisper-large-v3-turbo (default, faster) or whisper-large-v3 (more accurate).
GROQ_MODEL=whisper-large-v3-turbo

# fake (default) or groq. Groq is also selected automatically when GROQ_API_KEY is set.
SPEECH_PROVIDER=fake

# Optional. Both required to enable Nest Observe (https://observe.nestjs.com).
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
