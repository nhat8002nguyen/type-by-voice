{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "paths": {
      "@app/inbox": [
        "./libs/inbox/src/index.ts"
      ],
      "@app/inbox/*": [
        "./libs/inbox/src/*"
      ],
      "@app/notifications": [
        "./libs/notifications/src/index.ts"
      ],
      "@app/notifications/*": [
        "./libs/notifications/src/*"
      ],
      "@app/outbox": [
        "./libs/outbox/src/index.ts"
      ],
      "@app/outbox/*": [
        "./libs/outbox/src/*"
      ],
      "@app/quota": [
        "./libs/quota/src/index.ts"
      ],
      "@app/quota/*": [
        "./libs/quota/src/*"
      ],
      "@app/speech": [
        "./libs/speech/src/index.ts"
      ],
      "@app/speech/*": [
        "./libs/speech/src/*"
      ],
      "@app/tracing": [
        "./libs/tracing/src/index.ts"
      ],
      "@app/tracing/*": [
        "./libs/tracing/src/*"
      ],
      "@app/workflows": [
        "./libs/workflows/src/index.ts"
      ],
      "@app/workflows/*": [
        "./libs/workflows/src/*"
      ]
    },
    "types": [
      "vitest/globals",
      "node"
    ]
  },
  "files": [],
  "references": [
    {
      "path": "./apps/api/tsconfig.app.json"
    },
    {
      "path": "./apps/quota-service/tsconfig.app.json"
    },
    {
      "path": "./apps/speech-service/tsconfig.app.json"
    },
    {
      "path": "./apps/workflows-service/tsconfig.app.json"
    },
    {
      "path": "./apps/notifications-service/tsconfig.app.json"
    },
    {
      "path": "./libs/inbox/tsconfig.lib.json"
    },
    {
      "path": "./libs/notifications/tsconfig.lib.json"
    },
    {
      "path": "./libs/outbox/tsconfig.lib.json"
    },
    {
      "path": "./libs/quota/tsconfig.lib.json"
    },
    {
      "path": "./libs/speech/tsconfig.lib.json"
    },
    {
      "path": "./libs/tracing/tsconfig.lib.json"
    },
    {
      "path": "./libs/workflows/tsconfig.lib.json"
    }
  ]
}
